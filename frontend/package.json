{
  "name": "network-service-composer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run ui:check && npm run api:check && npm run i18n:check && npm run i18n:generate && vue-tsc -b --force && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b --force",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "i18n:check": "node scripts/check-i18n.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "ui:check": "node scripts/check-ui-deps.mjs && node scripts/check-archive.mjs && node --test scripts/service-references.check.mjs scripts/brand.check.mjs && node scripts/generate-compose-validator.mjs --check",
    "i18n:generate": "node scripts/catalogs.mjs --generate",
    "predev": "npm run i18n:generate",
    "pretypecheck": "npm run i18n:generate",
    "pretest": "npm run i18n:generate",
    "pretest:coverage": "npm run i18n:generate",
    "dev:demo": "node faker/dev.mjs",
    "build:demo": "npm run build",
    "preview:demo": "node faker/server.mjs",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "e2e:shared": "playwright test --config playwright.shared.config.ts",
    "e2e:workspace": "playwright test --config playwright.workspace.config.ts",
    "compose:generate": "node scripts/generate-compose-validator.mjs"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tanstack/vue-query": "^5.90.2",
    "ajv": "8.20.0",
    "entities": "6.0.1",
    "openapi-fetch": "^0.14.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.0.8"
  }
}
