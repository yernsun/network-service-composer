      ]
    },
    {
      "id": "unit",
      "workflowJob": "unit",
      "checks": [
        "harness",
        "modules",
        "race",
        "fuzz",
        "benchmarks",
        "vulnerability",
        "frontend"
      ]
    },
    {
      "id": "stores-postgres",
      "workflowJob": "stores",
      "checks": [
        "store"
      ]
    },
    {
      "id": "stores-mysql",
      "workflowJob": "stores",
      "checks": [
        "store"
      ]
    },
    {
      "id": "images-controller",
      "workflowJob": "images",
      "checks": [
        "build",
        "scan",
        "sbom"
      ],
      "images": [
        "controller"
      ]
    },
    {
      "id": "images-gateway",
      "workflowJob": "images",
      "checks": [
        "build",
        "nginx",
        "scan",
        "sbom"
      ],
      "images": [
        "gateway"
      ]
    },
    {
      "id": "compose",
      "workflowJob": "compose",
      "checks": [
        "compose"
      ]
