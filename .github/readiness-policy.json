    {
      "id": "ha-postgres",
      "workflowJob": "ha-e2e",
      "checks": [
        "build",
        "ha"
      ],
      "images": [
        "controller"
      ]
    },
    {
      "id": "ha-mysql",
      "workflowJob": "ha-e2e",
      "checks": [
        "build",
        "ha"
      ],
      "images": [
        "controller"
      ]
    },
    {
      "id": "docker-e2e",
      "workflowJob": "docker-e2e",
      "checks": [
        "build",
        "compose",
        "management",
        "delivery",
        "ui",
        "acme",
        "cluster",
        "swarm"
