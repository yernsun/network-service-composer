# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
ARG GO_IMAGE=golang:1.27.3-bookworm@sha256:05237276236793ebedaf0b87dab86add9ec9adc66ebef2dbc3107c18254cde1c
ARG NODE_IMAGE=node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

FROM ${NODE_IMAGE} AS node

FROM ${GO_IMAGE}
ARG TARGETARCH
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends curl unzip make iproute2 util-linux >/dev/null \
    && rm -rf /var/lib/apt/lists/*

# Keep the compiler and both plugins at the versions that produced api/gen.
# Verify the downloaded compiler before using it; the same checksum is pinned in CI.
RUN test "$TARGETARCH" = amd64 || { echo 'The pinned protoc archive supports linux/amd64 only' >&2; exit 1; } \
    && curl --fail --location --silent --show-error --retry 3 \
      -o /tmp/protoc.zip \
      https://github.com/protocolbuffers/protobuf/releases/download/v33.0/protoc-33.0-linux-x86_64.zip \
    && unzip -q /tmp/protoc.zip -d /usr/local \
    && echo '855eca120edab40ed611f2b3a5da25a654d22fa4c757de128c7e1dfb70c4d4e7  /usr/local/bin/protoc' | sha256sum --check \
    && rm /tmp/protoc.zip

RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.0 \
    && test "$(go version | cut -d' ' -f3)" = go1.27.3 \
    && test "$(node --version)" = v24.20.0 \
    && test "$(protoc --version)" = 'libprotoc 33.0' \
    && test "$(protoc-gen-go --version)" = 'protoc-gen-go v1.36.12' \
    && test "$(protoc-gen-go-grpc --version)" = 'protoc-gen-go-grpc 1.6.0'

WORKDIR /work
