# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
ARG NODE_IMAGE=node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf
ARG GO_IMAGE=golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb
ARG RUNTIME_IMAGE=nginx:1.31.5-alpine3.24@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3
ARG DOCKER_CLI_IMAGE=docker:29.9.2-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb

FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM ${NODE_IMAGE} AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
COPY api/openapi.yaml /src/api/openapi.yaml
COPY internal/i18n/catalogs /src/internal/i18n/catalogs
COPY internal/i18n/locales.json /src/internal/i18n/locales.json
COPY internal/composecheck/compose-spec.json /src/internal/composecheck/compose-spec.json
COPY .agents/rules/coverage.json /src/.agents/rules/coverage.json
RUN npm run build

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
COPY --from=frontend /src/internal/api/frontend-dist ./internal/api/frontend-dist
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -ldflags="-s -w -X main.version=${VERSION}" -o /out/nsc-controller ./cmd/nsc-controller

FROM ${RUNTIME_IMAGE}
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 65532 nsc \
    && adduser -S -D -H -u 65532 -G nsc nsc \
    && rm -f /etc/nginx/conf.d/default.conf /etc/nginx/nginx.conf \
    && mkdir -p /etc/nsc /var/lib/nsc/generations /var/cache/nginx \
    && touch /etc/nginx/nginx.conf \
    && chown nsc:nsc /etc/nginx/nginx.conf \
    && chown -R nsc:nsc /etc/nsc /var/lib/nsc /var/cache/nginx \
    && chmod 0750 /etc/nsc /var/lib/nsc
COPY --from=build /out/nsc-controller /usr/local/bin/nsc-controller
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/licenses/nsc/
COPY third_party /usr/share/licenses/nsc/third_party/
RUN chmod -R a+rX /usr/share/licenses/nsc
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
USER 65532:65532
EXPOSE 8080 9443 9444 9090 80 443 443/udp
STOPSIGNAL SIGTERM
ARG SOURCE_REVISION=unknown
ARG SOURCE_FINGERPRINT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
LABEL org.nsc.source.fingerprint=$SOURCE_FINGERPRINT
ENTRYPOINT ["/usr/local/bin/nsc-controller"]
CMD ["serve", "--config", "/etc/nsc/controller.yaml"]
